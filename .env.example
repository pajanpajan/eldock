# SQLite pro lokální vývoj (soubor vznikne v kořeni projektu)
DATABASE_URL="file:./dev.db"

# Přihlašovací brána (/login): společné přístupové heslo / PIN a tajemství podpisu cookie
ELDOCK_ACCESS_PASSWORD="eldock2026"
ELDOCK_AUTH_SECRET="zmente-na-dlouhy-nahodny-retezec"
# ELDOCK_BYPASS_AUTH="1"  # vypne bránu (jen lokální vývoj)
# ELDOCK_INSECURE_COOKIE="1"  # produkce bez HTTPS (např. interní síť bez certifikátu)
# Starší názvy DIGITRY_* fungují dál jako záloha.

# Avízo lhůt revizí (/inspections/alerts): bez SMTP se e-mail jen uloží do logu v databázi
# ELDOCK_SMTP_URL="smtps://uzivatel:heslo@smtp.example.cz:465"
# ELDOCK_MAIL_FROM="Eldock <noreply@eldock.cz>"
# Cron: POST /api/cron/inspection-alerts s hlavičkou "Authorization: Bearer <ELDOCK_CRON_SECRET>"
# ELDOCK_CRON_SECRET="dlouhy-nahodny-retezec"
# ELDOCK_PUBLIC_URL="https://eldock.cz"  # adresa pro odkazy v e-mailu volaném cronem

# AI Panel Builder (/panel-builder): analýza fotek rozváděčů a datasheetů přes Gemini.
# Bez klíče běží deterministický demo režim (v UI štítek „Demo AI režim“).
# Fáze 56: Google Analytics 4 jen po souhlasu (lišta cookies se ukáže, až je ID nastavené)
# ELDOCK_GA4_ID="G-XXXXXXXXXX"
# GEMINI_API_KEY=""
# GEMINI_VISION_MODEL="gemini-3.1-pro-preview"   # fáze 56: na zkušební fotce 95 % struktury vs. 19–24 % u gemini-2.5-pro; neznámý model -> záložní gemini-2.5-pro
# GEMINI_DATASHEET_MODEL="gemini-2.5-flash"

# Velín /superadmin (fáze 50): vlastní heslo (v produkci povinné, lokálně se použije ELDOCK_ACCESS_PASSWORD)
# ELDOCK_SUPERADMIN_PASSWORD=""
