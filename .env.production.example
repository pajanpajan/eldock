# Eldock – produkční proměnné pro docker compose (zkopírujte do .env.production, soubor necommitujte)

# Přístupové heslo / PIN na přihlašovací stránce
ELDOCK_ACCESS_PASSWORD="zmente-me"
# Tajemství podpisu přihlašovací cookie – vygenerujte: openssl rand -base64 32
ELDOCK_AUTH_SECRET=""

# Domény s automatickým certifikátem Let's Encrypt (DNS A/AAAA záznamy musí mířit na server)
ELDOCK_DOMAINS="eldock.cz, www.eldock.cz, app.eldock.cz"
ELDOCK_ACME_EMAIL="admin@eldock.cz"

# 1 = při prvním startu nahrát demo data (Závod Jablonec), 0 = prázdná aplikace pro ostrý provoz
ELDOCK_SEED_DEMO="1"
# 1 = provoz bez HTTPS v uzavřené síti (ELDOCK_DOMAINS=":80")
ELDOCK_INSECURE_COOKIE="0"

# Avízo lhůt revizí (/inspections/alerts): bez SMTP se e-mail jen uloží do logu v databázi
# ELDOCK_SMTP_URL="smtps://uzivatel:heslo@smtp.example.cz:465"
# ELDOCK_MAIL_FROM="Eldock <noreply@eldock.cz>"
# Cron: POST /api/cron/inspection-alerts s hlavičkou "Authorization: Bearer <ELDOCK_CRON_SECRET>"
# ELDOCK_CRON_SECRET="dlouhy-nahodny-retezec"
# ELDOCK_PUBLIC_URL="https://eldock.cz"  # adresa pro odkazy v e-mailu volaném cronem
