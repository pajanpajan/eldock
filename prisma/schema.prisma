/// Soupis domovní instalace obvodu: přístroje (vypínače, zásuvky, rámečky) napájené z přístroje rozváděče.
model PanelItemWiring {
  id             String  @id @default(cuid())
  itemId         String
  wiringDeviceId String
  quantity       Int     @default(1)
  room           String?

  item         PanelBoardItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  wiringDevice WiringDevice   @relation(fields: [wiringDeviceId], references: [id], onDelete: Cascade)

  @@unique([itemId, wiringDeviceId, room])
  @@index([wiringDeviceId])
