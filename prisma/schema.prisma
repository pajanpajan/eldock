  articleNumber String   @unique
  manufacturer  String
  series        String
  /// WD_SWITCH | WD_SOCKET | WD_FRAME | WD_COVER | WD_DATA | WD_BLIND | WD_SENSOR | WD_THERMOSTAT | WD_BELL | WD_DIMMER | WD_LIGHT | WD_OTHER
  category      String
  /// frame | complete | cover | mechanism | accessory
  role          String?
  title         String
  ean           String?
  color         String?
  /// Rámeček: počet míst (1R–6R).
  frameUnits    Int?
  ipRating      String?
  ratedCurrentA Float?
  widthMm       Float?
  heightMm      Float?
  depthMm       Float?
  productUrl    String?
  featuresJson  String?
  searchText    String
