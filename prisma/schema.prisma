// =============================================================================
//  Eldock – Industrial Electrical Documentation & Maintenance Twin (MVP)
//  Prisma schema · SQLite (dev) → PostgreSQL (prod)
//
//  Cílová verze: Prisma ORM 7.x
//  - Connection string (DATABASE_URL) je v /prisma.config.ts, ne ve schématu.
//  - Runtime klient se připojuje přes driver adapter
//    (@prisma/adapter-better-sqlite3 → později @prisma/adapter-pg).
//  - Vygenerovaný klient: src/generated/prisma (import z "@/generated/prisma/client").
//  - Strukturovaná data (redline tahy, SVG polygony) jsou uložena jako String
//    se serializovaným JSON/SVG obsahem, aby schéma fungovalo shodně
//    na SQLite i PostgreSQL. Při migraci na PostgreSQL lze přepnout na Json.
//  - Souřadnice pinů a map jsou v procentech (0–100) vůči viewBoxu podkladu,
//    takže nezávisí na rozlišení obrázku/SVG.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
//  ENUMY
// -----------------------------------------------------------------------------

/// Role uživatele – odpovídá přepínači pohledu v navbaru.
enum UserRole {
  MAINTENANCE // Pohled: Údržba v hale
  CAE_ENGINEER // Pohled: CAE Projektant
  ADMIN
}

/// Typ účtu (výřez dat a oprávnění). Workflow role se z něj odvozuje (lib/accounts.ts).
enum AccountType {
  PLANT_ADMIN // Technický ředitel – vše, KPI, audit, studio, správa účtů
  MAINTENANCE_LEAD // Vedoucí údržby – vše, schvaluje revize, LOTO, provizoria, závady
  MAINTENANCE_TECH // Směnový údržbář – pevná zařízení, zadává změny a provizoria
  INSPECTOR_VTZ // Revizní technik VTZ – jen vyhrazená technická zařízení
  INSPECTOR_APPLIANCES // Technik revizí spotřebičů – jen spotřebiče a nářadí
  CAE_ENGINEER // CAE projektant – výkresová dokumentace a požadavky na změnu
}

/// Stav dokumentace zařízení = barva pinu na půdorysu.
enum EquipmentStatus {
  ACTIVE // 🟢 dokumentace 100% aktuální
  PENDING_UPDATE // 🟠 nahlášena změna, CAE na ní pracuje
  WAITING_APPROVAL // 🔵 CAE nahrál novou revizi, čeká na potvrzení údržbou
}

enum EquipmentType {
  // Pevná infrastruktura (schéma, kusovník, 3D)
  SWITCHBOARD // Rozváděč
  TRANSFORMER // Transformátor / trafostanice
  PRODUCTION_LINE // Výrobní linka
  MACHINE // Pevný stroj
  CNC_MACHINE // CNC stroj
  ROBOT_CELL // Robotické pracoviště
  HVAC_UNIT // Vzduchotechnika
  COMPRESSOR // Kompresor
  // Spotřebiče a revizní zařízení (lehká karta bez schématu a 3D)
  POWER_TOOL // Ruční elektrické nářadí
  APPLIANCE // Spotřebič (konvice, mikrovlnka, PC)
  EXTENSION_CORD // Prodlužovací přívod
  WELDER // Svářečka
  LIGHTNING_ROD // Hromosvod / LPS
  EMERGENCY_LIGHTING // Nouzové osvětlení
  WIRING_DEVICE // Domovní přístroj – zásuvka, vypínač (fáze 47)
  OTHER
}

enum BuildingType {
  PRODUCTION // Výrobní hala
  ASSEMBLY // Montáž
  ENERGY // Energetika
  WAREHOUSE // Sklad
  OFFICE // Administrativa
  OTHER
}

/// Provedení VTZ pro nejdelší lhůty revizí (NV 190/2022 Sb., příloha č. 4) – fáze 66.
enum InstallationKind {
  STANDARD // pevná instalace – lhůta podle účelu objektu a prostoru
  CONSTRUCTION_SITE // prozatímní zařízení staveniště – 0,5 roku
  MOBILE // pojízdné a převozné prostředky – 1 rok
}

/// Životní cyklus revize dokumentace.
enum RevisionStatus {
  PENDING_APPROVAL // nahraná CAE, čeká na potvrzení údržbou
  ACTIVE // aktuálně platná (max. 1 na zařízení – hlídá aplikační logika)
  ARCHIVED // nahrazená novější revizí → Historie změn
  REJECTED // vrácena k přepracování
}

enum SchematicFormat {
  PDF
  SVG
  IMAGE
}

/// Stavový automat požadavku na změnu (Zadat změnu).
enum ChangeRequestStatus {
  SUBMITTED // technik odeslal, ticket v CAE back-office
  IN_PROGRESS // CAE projektant převzal / přepracovává
  WAITING_APPROVAL // nová revize nahrána, čeká na údržbu
  APPROVED // potvrzeno a propsáno do systému (uzavřeno)
  CANCELLED // stornováno
}

enum ChangeRequestPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL // bezpečnostně relevantní změna
}

enum AttachmentType {
  PHOTO // fotodokumentace z haly
  VOICE_NOTE // audio záznam (simulovaný)
  MARKUP_IMAGE // export redline vrstvy jako PNG
  OTHER
}

/// Auditní stopa změn ticketu (timeline v detailu ticketu).
enum ChangeRequestEventType {
  SUBMITTED
  ASSIGNED
  REVISION_UPLOADED
  APPROVED
  REJECTED
  COMMENT
  CANCELLED
}

/// Výrobní dokumentace rozváděče dle ČSN EN 61439 (Pasport & Shoda).
enum ComplianceCategory {
  SINGLE_LINE_DIAGRAM // Liniové schéma
  CONFORMITY_DECLARATION // EU prohlášení o shodě
  ROUTINE_VERIFICATION // Kusová zkouška (čl. 11)
  THERMAL_CALCULATION // Ověření oteplení výpočtem (čl. 10.10.4)
  EXTERNAL_INFLUENCES // Protokol o určení vnějších vlivů
}

/// Druh revize elektrického zařízení dle ČSN 33 1500.
enum InspectionType {
  INITIAL // Výchozí revize
  PERIODIC // Pravidelná revize
  EXTRAORDINARY // Mimořádná revize
  THERMOVISION // Termovizní měření (doplňkové, nepočítá se do lhůty)
  VISUAL_CHECK // Vizuální kontrola LPS 1× ročně (NV 190/2022 Sb., příl. 4) – neposouvá lhůtu revize (fáze 66)
}

/// Celkový posudek revizní zprávy.
enum InspectionResult {
  CAPABLE // Schopno bezpečného provozu
  CAPABLE_WITH_DEFECTS // Schopno bezpečného provozu s výhradou
  INCAPABLE // Neschopno bezpečného provozu
}

/// Dočasné provizorium v zařízení (nemění oficiální dokumentaci).
enum TemporaryModStatus {
  ACTIVE // aktivní provizorium – varuje obsluhu
  RESTORED_1_TO_1 // odstraněno, vráceno do stavu 1:1 dle schématu
  CONVERTED_TO_CR // odstraněno, finální stav se liší → požadavek na změnu dokumentace
}

/// Závažnost revizní závady (lhůta odstranění).
enum DefectSeverity {
  MINOR // drobná – do 90 dnů
  MAJOR // závažná – do 30 dnů
  CRITICAL // kritická – ihned, zařízení mimo provoz
}

enum DefectStatus {
  OPEN
  RESOLVED
}

// -----------------------------------------------------------------------------
//  UŽIVATELÉ
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  company   String? // např. "Závod Jablonec – Údržba" / "Eldock CAE"
  phone     String?
  avatarUrl String?

  // Účet v aplikaci (null = historický uživatel bez přihlášení, např. autor starých revizí)
  accountType AccountType?
  title       String? // „Technický ředitel“
  scopeLayers String? // vlastní výřez kategorií (klíče vrstev mapy oddělené čárkou); null = výchozí pro typ účtu
  sortOrder   Int          @default(0)
  /// Registrovaný uživatel (fáze 41): vidí jen svůj závod, bez přepínače účtů.
  homePlantId String?
  companyId   String?

  /// Fáze 67: vlastní heslo uživatele registrované firmy (scrypt, src/server/password.ts). Demo účty ho nemají –
  /// přihlašují se sdíleným heslem obchodního dema. Bez hesla = čeká na nastavení z pozvánky.
  passwordHash       String?
  passwordChangedAt  DateTime?
  /// Po převzetí společného hesla firmy si zaměstnanec heslo změní při prvním přihlášení.
  mustChangePassword Boolean   @default(false)
  /// Zablokovaný účet (odchod zaměstnance) – nepřihlásí se a jeho relace jsou zrušené.
  disabledAt         DateTime?
  lastLoginAt        DateTime?
  /// Dvoufázové ověření TOTP (RFC 6238): tajemství šifrované klíčem aplikace, záložní kódy jako SHA-256 (JSON pole).
  totpSecret         String?
  totpEnabledAt      DateTime?
  totpRecoveryJson   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  homePlant         Plant?             @relation("UserHomePlant", fields: [homePlantId], references: [id], onDelete: SetNull)
  registeredCompany RegisteredCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessions          UserSession[]
  authTokens        AuthToken[]

  authoredRevisions      DocumentRevision[]   @relation("RevisionAuthor")
  approvedRevisions      DocumentRevision[]   @relation("RevisionApprover")
  reportedChangeRequests ChangeRequest[]      @relation("ChangeRequestReporter")
  assignedChangeRequests ChangeRequest[]      @relation("ChangeRequestAssignee")
  changeRequestEvents    ChangeRequestEvent[]
  uploadedAttachments    Attachment[]
  equipmentDocuments     EquipmentDocument[]
  softwareBackups        SoftwareBackup[]
  syncDevices            SyncDevice[]
  syncPairings           SyncPairing[]
  syncMutations          SyncMutation[]

  @@index([role])
  @@index([accountType])
  @@index([homePlantId])
}

/// Přihlášení uživatele registrované firmy na jednom zařízení (fáze 67) – odhlášení a blokace relaci zruší.
model UserSession {
  id         String    @id @default(cuid())
  userId     String
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Popis zařízení z User-Agent („Chrome · Windows“), bez IP adresy.
  device     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

enum AuthTokenKind {
  INVITE // pozvánka zaměstnance – nastavení prvního hesla (7 dní)
  RESET // obnova zapomenutého hesla (1 h; od správce firmy 24 h)
}

/// Jednorázový odkaz na nastavení hesla (fáze 67). Samotný token je jen v odkazu, v databázi SHA-256.
model AuthToken {
  id          String        @id @default(cuid())
  userId      String
  kind        AuthTokenKind
  tokenHash   String        @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

enum SecurityEventKind {
  LOGIN_OK
  LOGIN_FAILED
  LOGIN_LOCKED // pokus během zablokování po opakovaných chybách
  TOTP_FAILED
  LOGOUT
  PASSWORD_SET // nastavení hesla z pozvánky / obnovy
  PASSWORD_CHANGED
  RESET_REQUESTED
  INVITE_CREATED
  SESSION_REVOKED
  USER_DISABLED
  USER_ENABLED
  TOTP_ENABLED
  TOTP_DISABLED
  DATA_EXPORTED // fáze 69: export dat firmy / vlastních údajů
  USER_REMOVED // odebrání zaměstnance (anonymizace účtu)
  COMPANY_CLOSURE_REQUESTED // žádost o zrušení účtu firmy (výmaz po lhůtě)
  COMPANY_CLOSURE_CANCELLED
  DEVICE_PAIRED // fáze 70: spárování aplikace (Windows, iOS, Android, server závodu)
  DEVICE_REVOKED // odpojení zařízení (uživatel, správce firmy, změna hesla, blokace)
  DEVICE_PAIR_FAILED // chybný nebo prošlý kód párování (limit pokusů na IP)
}

/// Bezpečnostní deník (fáze 67): přihlášení, chyby, změny hesla a účtů. Slouží i k limitu pokusů – IP jen jako HMAC.
model SecurityEvent {
  id        String            @id @default(cuid())
  kind      SecurityEventKind
  userId    String?
  companyId String?
  actorId   String?
  email     String?
  ipKey     String?
  detail    String?
  createdAt DateTime          @default(now())

  @@index([kind, email, createdAt])
  @@index([kind, ipKey, createdAt])
  @@index([companyId, createdAt])
}

// -----------------------------------------------------------------------------
//  LOKALITY – 3úrovňová mapa (Areál → Budova/Patro → Půdorys)
// -----------------------------------------------------------------------------

/// Level 1 – Závod / areál klienta.
model Plant {
  id           String  @id @default(cuid())
  code         String  @unique // např. "JBC"
  name         String // "Závod Jablonec"
  customerName String // název klientské firmy
  address      String?
  city         String?
  country      String  @default("CZ")

  // Podklad mapy areálu (SVG generované v aplikaci nebo nahraný obrázek)
  campusMapUrl   String?
  campusViewBoxW Int     @default(1000)
  campusViewBoxH Int     @default(700)
  // Skutečný rozměr pozemku v metrech (převod rozměru budovy ve Studiu na mapu)
  campusWidthM   Int     @default(400)
  campusDepthM   Int     @default(280)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings           Building[]
  registeredCompanies RegisteredCompany[]
  homeUsers           User[]              @relation("UserHomePlant")
}

/// Budova v areálu – klikací oblast v Campus View.
model Building {
  id           String       @id @default(cuid())
  plantId      String
  code         String // "A", "B", "E"
  name         String // "Hala A - Lisovna"
  shortName    String? // "Lisovna"
  type         BuildingType @default(PRODUCTION)
  description  String?
  /// Objekt podle požárně bezpečnostního řešení umožňuje přítomnost více než 200 osob – VTZ I. třídy, revize 2 roky (fáze 66).
  crowdOver200 Boolean      @default(false)

  // Geometrie v Campus View (procenta vůči viewBoxu areálu)
  mapPolygon String // SVG points "x1,y1 x2,y2 ..." – obrys budovy
  labelX     Float // pozice štítku/badge
  labelY     Float
  color      String? // volitelný akcent (#hex)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant  Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@unique([plantId, code])
  @@index([plantId])
}

/// Level 2/3 – Patro budovy (izometrický výběr + 2D půdorys).
model Floor {
  id          String  @id @default(cuid())
  buildingId  String
  level       Int // -1 = 1. PP, 0 = 1. NP, 1 = 2. NP …
  code        String // "1PP", "1NP", "2NP"
  name        String // "1. PP - Rozvodny"
  description String?

  // Level 3 – podklad půdorysu (SVG generované v aplikaci nebo nahraný soubor)
  floorplanUrl     String?
  floorplanSvg     String? // inline SVG půdorysu (mock grafika bez externích assetů)
  viewBoxW         Int     @default(1200)
  viewBoxH         Int     @default(800)
  /// Zdrojová definice patra ze Studia (JSON: rastr, zóny v metrech, vrata) – zpětná editace patra.
  studioLayoutJson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  building  Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipment Equipment[]

  @@unique([buildingId, level])
  @@unique([buildingId, code])
  @@index([buildingId])
}

// -----------------------------------------------------------------------------
//  ZAŘÍZENÍ (ASSET)
// -----------------------------------------------------------------------------

/// Elektrické zařízení – pin na půdorysu, cíl QR kódu /equipment/[id].
model Equipment {
  id          String          @id @default(cuid())
  floorId     String
  tag         String // označení dle dokumentace: "RM1", "R-CNC-04"
  name        String // "RM1 - Hlavní rozváděč"
  type        EquipmentType
  status      EquipmentStatus @default(ACTIVE)
  description String?

  manufacturer  String?
  model         String?
  serialNumber  String?
  yearInstalled Int?
  ratedVoltage  String? // "400 V AC / 50 Hz"
  ratedCurrent  String? // "1600 A"
  ipRating      String? // "IP54"

  // Pozice pinu na půdorysu patra (procenta 0–100)
  pinX Float
  pinY Float

  // Hierarchie napájení – ze kterého rozváděče a vývodu je zařízení napájeno
  fedFromEquipmentId String?
  fedFromCircuit     String? // "Pole 3 / Jistič QF4"

  // Pasport a lhůtník revizí
  inspectionIntervalMonths Int              @default(36) // lhůta pravidelné revize – nejvýš podle lib/inspection-rules.ts (NV 190/2022 Sb., příl. 4)
  externalInfluences       String? // "AA5, AB4, BA4 – normální průmyslové"
  /// Fáze 66: provedení (staveniště 0,5 roku, pojízdné 1 rok), LPS chránící kritické systémy (2 roky)
  /// a lhůta stanovená řádem preventivní údržby (až dvojnásobná) – NV 190/2022 Sb., příloha č. 4.
  installationKind         InstallationKind @default(STANDARD)
  lpsCritical              Boolean          @default(false)
  preventiveMaintenance    Boolean          @default(false)

  // Spotřebiče a nářadí (ČSN 33 1600 ed. 2)
  usageGroup      String? // skupina A–E (C = průmysl, E = administrativa)
  protectionClass String? // třída ochrany "I" / "II" / "III"
  handHeld        Boolean @default(false) // spotřebič držený v ruce (sloupec tab. 1 ČSN 33 1600 ed. 2; nářadí a přívody vždy)
  inventoryNumber String?
  assignedZone    String? // "Kuchyňka – Energetika 1. NP", "Dílna údržby"

  // Vizuální karta a QR štítek
  photoUrl            String? // fotografie zařízení (/api/files/photos/…)
  qrToken             String? @unique // kód fyzického QR štítku – přegenerováním přestane starý štítek platit
  /// Digitální pas baterie dle Nařízení (EU) 2023/1542 (UPS, BESS > 2 kWh) – JSON (fáze 46).
  batteryPassportJson String?

  // Fáze 53: provozní profil (prediktivní údržba) a přívodní kabel (ČSN 33 2000-5-52 ed. 2)
  shiftRegime             Int     @default(2) // 1 = 1 směna, 2 = 2 směny, 3 = 3 směny, 4 = 24/7
  internalTempC           Float? // vnitřní teplota rozváděče [°C] (Arrhenius), bez údaje 35 °C
  feederCableType         String? // "CYKY-J", "1-CXKH-R", "AYKY", "ÖLFLEX CLASSIC 110"
  feederConductorMaterial String  @default("CU") // "CU" | "AL"
  feederCrossSectionMm2   Float? // průřez fázového vodiče [mm²]
  feederParallelRuns      Int     @default(1) // paralelní kabely na fázi
  feederLengthM           Float? // délka trasy [m]
  feederInstallMethod     String  @default("E") // B2 / C / E / D
  feederGroupingCount     Int     @default(1) // souběžné zatížené kabely v trase
  feederAmbientTempC      Float   @default(30) // teplota okolí trasy [°C]
  feederUpstreamBreakerA  Float? // In předřazeného jističe [A]
  nominalCurrentA         Float? // výpočtový odběr Ib [A]
  measuredCurrentA        Float? // proud naměřený klešťovým ampérmetrem [A]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor               Floor                   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fedFrom             Equipment?              @relation("PowerFeed", fields: [fedFromEquipmentId], references: [id], onDelete: SetNull)
  feeds               Equipment[]             @relation("PowerFeed")
  revisions           DocumentRevision[]
  changeRequests      ChangeRequest[]
  complianceDocuments ComplianceDocument[]
  inspections         InspectionRecord[]
  schematicReferences SchematicReference[]    @relation("SchematicReferenceTarget")
  defects             InspectionDefect[]
  temporaryMods       TemporaryModification[]
  panelProjects       PanelBoardProject[]
  documents           EquipmentDocument[]
  softwareBackups     SoftwareBackup[]
  monitoredComponents MonitoredComponent[]

  @@unique([floorId, tag])
  @@index([floorId])
  @@index([status])
  @@index([fedFromEquipmentId])
  @@index([type])
}

/// Dokument výrobní dokumentace rozváděče (ČSN EN 61439) – záložka Pasport & Shoda.
model ComplianceDocument {
  id             String             @id @default(cuid())
  equipmentId    String
  category       ComplianceCategory
  title          String
  documentNumber String
  fileUrl        String
  issuedAt       DateTime
  issuer         String // výrobce rozváděče / projektant
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, category])
}

/// Revizní zpráva nebo termovizní měření – záložka Revize & Lhůtník.
model InspectionRecord {
  id               String           @id @default(cuid())
  equipmentId      String
  type             InspectionType
  inspectionDate   DateTime
  validUntil       DateTime
  reportNumber     String
  inspectorName    String
  inspectorLicense String // ev. č. osvědčení revizního technika (zákon 250/2021 Sb., § 11; NV 190/2022 Sb., příloha č. 5)
  result           InspectionResult
  defectsSummary   String?
  reportUrl        String

  // Fáze 66: náležitosti zprávy o revizi VTZ (NV 190/2022 Sb., § 10 odst. 1) a osvědčení RT (§ 17 zákona 250/2021 Sb.)
  inspectorScope      String? // rozsah osvědčení "E1A" … "E3B" (příloha č. 5: E1 / E2 / E3, A bez a B s nebezpečím výbuchu)
  inspectorValidUntil DateTime? // platnost osvědčení
  scopeNote           String? // c) vymezení rozsahu revize
  extraordinaryReason String? // e) důvod mimořádné revize
  startedAt           DateTime? // f) zahájení revize (ukončení = inspectionDate)
  reportedAt          DateTime? // f) vypracování zprávy
  handedOverAt        DateTime? // f) předání zprávy
  documentsUsed       String? // h) podklady a jejich vyhodnocení
  actsPerformed       String? // i) soupis provedených úkonů
  previousEvaluation  String? // m) vyhodnocení záznamů z předchozí revize, provozu a údržby
  /// Původní platnost ze zprávy, pokud ji Eldock zkrátil na nejdelší zákonnou lhůtu (jednorázová oprava fáze 66).
  validUntilOriginal  DateTime?

  // Měření (revize spotřebičů a nářadí)
  measuringInstrument           String? // "Metrel MI 3309 BT"
  protectiveConductorResistance Float? // R_PE [Ω]
  insulationResistance          Float? // R_iso [MΩ]
  leakageCurrent                Float? // unikající / rozdílový proud I_PE / I_Δ [mA]
  functionalTest                Boolean? // funkční zkouška vyhověla (null = neprováděla se)
  rcdTestJson                   String? // fáze 52: zkoušky RCD dle ČSN EN 61557-6 ed. 2 (0,5·IΔn, tΔ, IΔ, Zsm) – lib/rcd-test.ts

  // Termovize
  maxTempC   Float? // nejvyšší naměřená teplota [°C]
  deltaTempC Float? // ΔT vůči okolí [K]

  defects   InspectionDefect[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, inspectionDate])
  @@index([validUntil])
  @@index([equipmentId, type, validUntil])
}

// -----------------------------------------------------------------------------
//  DOKUMENTACE – revize (aktivní + Historie změn)
// -----------------------------------------------------------------------------

/// Jedna revize elektrodokumentace zařízení (v1.0, v1.1, v2.0 …).
model DocumentRevision {
  id          String         @id @default(cuid())
  equipmentId String
  version     String // zobrazované "v1.2"
  major       Int // 1
  minor       Int // 2
  status      RevisionStatus @default(PENDING_APPROVAL)

  title   String // "Elektrické schéma rozváděče RM1"
  summary String? // technické shrnutí změn od CAE projektanta

  // Soubory
  schematicUrl    String // PDF/SVG/obrázek schématu
  schematicFormat SchematicFormat @default(PDF)
  sheetCount      Int             @default(1)
  thumbnailUrl    String?
  bomFileUrl      String? // export kusovníku (XLSX/CSV)
  layoutUrl       String? // dispozice rozváděče
  model3dUrl      String? // 3D náhled skříně (GLB)

  // Autor / schvalovatel
  authorId   String
  approverId String?
  approvedAt DateTime?

  // Odkud revize vznikla (null = výchozí digitalizace)
  changeRequestId  String?
  rejectionComment String? // důvod vrácení k přepracování

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  author        User           @relation("RevisionAuthor", fields: [authorId], references: [id])
  approver      User?          @relation("RevisionApprover", fields: [approverId], references: [id])
  changeRequest ChangeRequest? @relation("ResolvingRevisions", fields: [changeRequestId], references: [id], onDelete: SetNull)

  bomItems            BomItem[]
  references          SchematicReference[]
  markedUpInRequests  ChangeRequest[]      @relation("BaseRevision")
  changeRequestEvents ChangeRequestEvent[]

  @@unique([equipmentId, major, minor])
  @@index([equipmentId, status])
  @@index([changeRequestId])
  @@index([authorId])
  @@index([approverId])
}

/// Položka kusovníku (BOM) dané revize.
model BomItem {
  id           String  @id @default(cuid())
  revisionId   String
  position     Int // pořadí v tabulce
  designation  String // označení ve schématu: "K4", "Q1", "F12"
  description  String // "Stykač 3P 25 A, cívka 24 V DC"
  manufacturer String?
  partNumber   String? // objednací číslo
  quantity     Float   @default(1)
  unit         String  @default("ks")
  note         String?

  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
}

// -----------------------------------------------------------------------------
//  POŽADAVKY NA ZMĚNU (Zadat změnu → CAE → Schválení → Archiv)
// -----------------------------------------------------------------------------

/// Ticket "As-Built" změny nahlášený údržbou z haly.
model ChangeRequest {
  id          String                @id @default(cuid())
  number      String                @unique // "ZM-2026-0012"
  equipmentId String
  status      ChangeRequestStatus   @default(SUBMITTED)
  priority    ChangeRequestPriority @default(NORMAL)

  // Krok 1 – Redlining nad aktuálním schématem
  baseRevisionId String? // revize, nad kterou technik kreslil
  markupSheet    Int     @default(1) // číslo listu schématu
  markupData     String? // JSON: tahy pera [{points:[[x,y]...], color, width}]
  markupImageUrl String? // PNG export (schéma + červená vrstva)

  // Krok 3 – hlas / rychlá poznámka
  voiceTranscript String? // přepis hlasové poznámky
  note            String? // ručně psaná rychlá poznámka

  // Účastníci
  reporterId String
  assigneeId String? // CAE projektant

  // Odpověď CAE / výsledek
  engineerSummary String?

  /// Klasifikace zásahu dle Nařízení (EU) 2023/1230 (fáze 46).
  safetyImpact           SafetyImpactLevel @default(NONE_1_TO_1)
  /// Zásah vyžaduje i úpravu / zálohu řídicího SW nebo parametrů měniče.
  requiresSoftwareUpdate Boolean           @default(false)

  submittedAt DateTime  @default(now())
  assignedAt  DateTime?
  resolvedAt  DateTime? // nahrání revize k potvrzení
  closedAt    DateTime? // schváleno / stornováno
  updatedAt   DateTime  @updatedAt

  equipment          Equipment               @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  baseRevision       DocumentRevision?       @relation("BaseRevision", fields: [baseRevisionId], references: [id], onDelete: SetNull)
  reporter           User                    @relation("ChangeRequestReporter", fields: [reporterId], references: [id])
  assignee           User?                   @relation("ChangeRequestAssignee", fields: [assigneeId], references: [id])
  resolvingRevisions DocumentRevision[]      @relation("ResolvingRevisions")
  attachments        Attachment[]
  events             ChangeRequestEvent[]
  temporaryMods      TemporaryModification[]
  softwareBackups    SoftwareBackup[]

  @@index([equipmentId, status])
  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([baseRevisionId])
  @@index([submittedAt])
}

/// Přílohy ticketu – fotky z haly (Krok 2), hlasové poznámky, export markupu.
model Attachment {
  id              String         @id @default(cuid())
  changeRequestId String
  type            AttachmentType
  url             String
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  caption         String?
  /// Původní fotka před zákresem (kreslení do fotky) – CAE si přečte i text pod červenou čarou.
  originalUrl     String?
  uploadedById    String
  createdAt       DateTime       @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])

  @@index([changeRequestId])
  @@index([uploadedById])
}

/// Timeline událostí ticketu (stavový automat + komentáře).
model ChangeRequestEvent {
  id              String                 @id @default(cuid())
  changeRequestId String
  type            ChangeRequestEventType
  actorId         String
  revisionId      String? // revize, které se událost týká
  fromStatus      ChangeRequestStatus?
  toStatus        ChangeRequestStatus?
  comment         String?
  createdAt       DateTime               @default(now())

  changeRequest ChangeRequest     @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  actor         User              @relation(fields: [actorId], references: [id])
  revision      DocumentRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([changeRequestId, createdAt])
  @@index([actorId])
  @@index([revisionId])
}

/// Závada z revizní zprávy – sleduje se až do odstranění.
model InspectionDefect {
  id                 String         @id @default(cuid())
  inspectionId       String
  equipmentId        String
  description        String
  /// Porušené ustanovení předpisu nebo normy (NV 190/2022 Sb., § 10 odst. 1 písm. k) – fáze 66.
  provision          String?
  severity           DefectSeverity @default(MAJOR)
  deadline           DateTime
  status             DefectStatus   @default(OPEN)
  resolvedAt         DateTime?
  resolvedBy         String?
  resolutionNote     String?
  resolutionPhotoUrl String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  equipment  Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, status])
  @@index([inspectionId])
  @@index([status, deadline])
}

/// Dočasné provizorní zapojení (např. náhrada dílu čekající na dodávku) – do 7–14 dnů odstranit.
model TemporaryModification {
  id             String             @id @default(cuid())
  equipmentId    String
  number         String             @unique // "PROV-2026-0001"
  title          String
  description    String
  createdByName  String
  createdByRole  String // "Revizní technik" / "Údržba"
  createdAt      DateTime           @default(now())
  expiresAt      DateTime // povinný termín odstranění
  photoUrl       String?
  markupJson     String?
  status         TemporaryModStatus @default(ACTIVE)
  resolvedAt     DateTime?
  resolvedByName String?
  resolutionNote String?
  updatedAt      DateTime           @updatedAt

  spawnedChangeRequestId String?

  equipment            Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  spawnedChangeRequest ChangeRequest? @relation(fields: [spawnedChangeRequestId], references: [id], onDelete: SetNull)

  @@index([equipmentId, status])
  @@index([status, expiresAt])
  @@index([spawnedChangeRequestId])
}

/// Log odeslaných notifikací (souhrnné avízo lhůt revizí). Bez SMTP se e-mail jen uloží sem.
model NotificationLog {
  id          String   @id @default(cuid())
  kind        String // "INSPECTION_DIGEST"
  plantId     String?
  subject     String
  recipients  String // e-maily oddělené čárkou
  html        String
  text        String
  itemCount   Int
  delivery    String // "SENT" | "LOGGED" | "FAILED"
  error       String?
  triggeredBy String // "manual:<userId>" | "cron"
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([kind, plantId, createdAt])
}

/// Interaktivní reference ve výkresu revize (CAE): značka prvku s pozicí na stránce a volitelnou
/// vazbou na kartu zařízení. Souřadnice v procentech stránky (levý okraj a účaří popisku).
model SchematicReference {
  id                String   @id @default(cuid())
  revisionId        String
  page              Int      @default(1)
  designation       String // "-Q1", "-M1"
  title             String // "Hlavní vypínač přívodu"
  description       String?
  x                 Float
  y                 Float
  linkedEquipmentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  revision        DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  linkedEquipment Equipment?       @relation("SchematicReferenceTarget", fields: [linkedEquipmentId], references: [id], onDelete: SetNull)

  @@index([revisionId, page])
  @@index([linkedEquipmentId])
}

/// Licenční moduly (add-ony nad Core) – globální konfigurace tenantu. Chybějící řádek = modul zapnutý.
model TenantModule {
  key         String   @id // "INSPECTIONS_PRO" | "CAE_ADVANCED" | "ENTERPRISE_TOOLS"
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Podfunkce licenčních modulů ("cae.visual_diff", "inspections.alerts" …). Účinná jen se zapnutým
/// modulem. Chybějící řádek = zapnuto.
model TenantFeature {
  key         String   @id
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Nastavení tenantu (klíč → hodnota), např. "modules.displayMode" = "CLEAN" | "UPSELL".
model TenantSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
//  REGISTROVANÉ FIRMY (fáze 41) – AI Panel Builder a Správa závodů jako samostatné produkty
// -----------------------------------------------------------------------------

enum ProductScope {
  PANEL_BUILDER // ELDOCK AI Panel Builder – výrobce rozváděčů / projektant
  PLANT_MANAGEMENT // ELDOCK Průmyslový dok – správa závodu, dokumentace a revizí
}

/// Firma registrovaná do jednoho z produktů (IČO z ARES, odpovědná osoba, souhlas s VOP a přenesením odpovědnosti).
model RegisteredCompany {
  id                   String       @id @default(cuid())
  productScope         ProductScope
  ico                  String
  dic                  String?
  companyName          String // propisuje se jako Výrobce rozváděče
  street               String
  city                 String
  zip                  String
  contactName          String // odpovědná osoba / projektant
  email                String       @unique // přihlašovací e-mail
  phone                String
  passwordHash         String // scrypt (node:crypto), viz src/server/password.ts
  authorizationNumber  String? // ev. č. oprávnění firmy (zákon 250/2021 Sb., § 8) nebo osvědčení revizního technika (§ 11)
  termsAcceptedAt      DateTime
  termsVersion         String       @default("1.0-2026-11")
  creditsRemaining     Int          @default(5)
  plantId              String? // vlastní závod (PLANT_MANAGEMENT)
  /// Firemní logo (fáze 43) – titulní list, rohové razítko výkresů a výrobní štítek CE.
  logoUrl              String?
  /// Otisk razítka a podpisu odpovědné osoby (PNG s průhledným pozadím) – prohlášení o shodě a kusová zkouška.
  stampUrl             String?
  /**
   * Rychlé štítky funkce obvodu se Smart Presety (fáze 45), JSON { chips, updatedAt }.
   */
  circuitChipsJson     String?
  /// Knihovna samostatných spotřebičů 2D půdorysu (fáze 63), JSON { specs, updatedAt } – vyhrává novější.
  applianceLibraryJson String?
  /// Fáze 78: knihovna 2D půdorysu firmy – šablony sestav ve víceramečku a oblíbené položky levého panelu (JSON `FloorplanLibrary`).
  floorplanLibraryJson String?
  /// Fáze 69: zrušená firma – zůstávají jen fakturační údaje kvůli dokladům k objednávkám kreditů (bez kontaktu a přihlášení).
  closedAt             DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  plant         Plant?              @relation(fields: [plantId], references: [id], onDelete: SetNull)
  panelProjects PanelBoardProject[]
  users         User[]
  creditOrders  CreditOrder[]
  aiFeedback    AiFeedbackReport[]
  floorplans    Floorplan[]

  @@index([productScope])
  @@index([ico])
  @@index([plantId])
}

// -----------------------------------------------------------------------------
//  AI PANEL BUILDER – katalog prvků a projekty rozváděčů (fáze 27–31)
// -----------------------------------------------------------------------------

enum ComponentCategory {
  MAIN_SWITCH // hlavní vypínač / odpínač
  MCB // jistič
  RCD // proudový chránič
  RCBO // jističochránič
  SPD // přepěťová ochrana
  CONTACTOR
  RELAY
  PSU
  PLC
  TERMINAL
  ENCLOSURE
  OTHER
}

/// Původ dat prvku v katalogu.
enum ComponentDataSource {
  SEED_CATALOG // výchozí katalog Eldocku
  PDF_DATASHEET // vytěženo z PDF datasheetu / kusovníku
  GEMINI_AI // dohledáno přes Gemini AI
  IEC_ESTIMATE // parametry z PDF, ztrátový výkon odhadnut podle IEC tabulek
}

enum PanelProjectStatus {
  DRAFT // založeno, čeká na analýzu fotky
  RECOGNIZED // prvky rozpoznány (krok 1)
  TREE_BUILT // strom zapojení sestaven (krok 2)
  COMPLETED // dokumentace propuštěna do provozu (krok 4)
}

enum EnclosureType {
  WALL_MOUNTED // nástěnný
  FLUSH_MOUNTED // zapuštěný
  FREE_STANDING // volně stojící
}

enum EnclosureMaterial {
  PLASTIC
  PAINTED_STEEL
  STAINLESS_STEEL
}

/// Stav rozpoznání modulu na fotce (barva rámečku).
enum RecognitionStatus {
  VERIFIED // zelená – spárováno s katalogem
  PARTIAL // žlutá – k rychlému potvrzení
  UNRECOGNIZED // červená s otazníkem
}

/// Atomická databáze prvků: každý přístroj z datasheetu je samostatný řádek (PDF nikdy v kuse).
model CatalogComponent {
  id                 String              @id @default(cuid())
  manufacturer       String // "ABB", "Eaton", "OEZ", "Schneider"
  series             String // "System pro M compact S200"
  typeCode           String // "S201-B16"
  articleNumber      String              @unique // "2CDS251001R1165"
  ean                String?
  category           ComponentCategory
  poles              String // "1P" | "1P+N" | "2P" | "3P" | "3P+N" | "4P"
  ratedCurrentA      Float // In [A]
  trippingCurve      String? // "B" | "C" | "D"
  breakingCapacityKa Float? // Icn [kA]
  rcdSensitivityMa   Int? // IΔn [mA]
  rcdType            String? // "AC" | "A" | "B" | "F" | "G" | "S"
  spdType            String? // "T1" | "T1+T2" | "T2" | "T2+T3" | "T3"
  surgeCurrentKa     Float? // svodičový proud SPD [kA]
  contactConfig      String? // stykač: "2NO" | "3NO" | "4NO" | "2NO+2NC"
  coilVoltage        String? // stykač: "230V AC" | "24V AC/DC" | "12V DC"
  relaySubtype       String? // "IMPULSE" | "TIMER" | "AUXILIARY" | "LEVEL" | "MONITORING" | "STAIRCASE" | "THERMOSTAT"
  moduleSubtype      String? // zdroj / měření / jiné: "PSU_DC" | "BELL_TRANSFORMER" | "METER" | "PLC" | "MAIN_TERMINAL" | "FUSE_DISCONNECTOR"
  modulesCount       Float // šířka v modulech 18 mm
  widthMm            Float?
  heightMm           Float?
  depthMm            Float?
  powerLossWatts     Float // jmenovitý ztrátový výkon Pn při In [W] – vstup výpočtu oteplení
  iecSymbol          String              @default("GENERIC") // "SWITCH_3P" | "SPD_T2" | "RCD_4P" | "MCB_1P" | "MCB_3P" | "CONTACTOR" | "GENERIC"
  description        String
  dataSource         ComponentDataSource @default(SEED_CATALOG)
  sourcePdfName      String?
  sourcePage         Int?
  searchText         String // lowercase bez diakritiky: výrobce, řada, typ, obj. číslo, popis
  /// 2D vektorový archetyp z externí databáze („din_mcb_1M_1P“, fáze 43).
  archetypeId        String?
  /// ETIM fasety a doplňkové parametry z externí databáze (JSON).
  facetsJson         String?
  /// Původ externího záznamu („ai-panel-builder“) – null = vlastní katalog Eldocku.
  externalSource     String?
  /// Odkaz na datasheet / produktovou stránku výrobce (fáze 47).
  datasheetUrl       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items     PanelBoardItem[]
  /// Příslušenství a vazby (pomocné kontakty, spouště, hřebeny, pojistkové vložky).
  relations CatalogRelation[] @relation("CatalogRelationParent")
  relatedBy CatalogRelation[] @relation("CatalogRelationChild")

  @@index([category, poles, ratedCurrentA, trippingCurve])
  @@index([manufacturer, typeCode])
}

/// Projekt rozváděče (pasportizace z fotky → strom zapojení → oteplení → dokumentace).
model PanelBoardProject {
  id                   String             @id @default(cuid())
  name                 String
  code                 String             @unique // "PB-001"
  equipmentId          String? // propuštěno do provozu = karta rozváděče v Eldocku
  customerName         String?
  /// Místo instalace rozváděče (fáze 48) – hlavička projektu a titulní list dokumentace.
  installationSite     String?
  manufacturerInfoJson String             @default("{}") // výrobce rozváděče: { name, address, city, phone }
  status               PanelProjectStatus @default(DRAFT)

  enclosureType          EnclosureType     @default(WALL_MOUNTED)
  enclosureMaterial      EnclosureMaterial @default(PLASTIC)
  enclosureModel         String            @default("")
  norm                   String            @default("EN 61439-3")
  widthMm                Int               @default(292)
  heightMm               Int               @default(507)
  depthMm                Int               @default(120)
  ipRating               String            @default("IP 41")
  networkSystem          String            @default("3 x 230/400 V, 50Hz, TN-S")
  /// Fáze 55: počet fází přívodu (1 = 1× 230 V, 3 = 3× 230/400 V); typ sítě TN-C-S / TN-S / TT je v `networkSystem` (lib/panel-builder/supply.ts).
  supplyPhases           Int               @default(3)
  shortCircuitKa         Float             @default(6)
  ambientTempC           Float             @default(30)
  simultaneityFactor     Float             @default(0.5)
  internalWiringLossW    Float             @default(4.1)
  dinRailsCount          Int               @default(3)
  modulesPerRail         Int               @default(12)
  photoUrl               String?
  dominantManufacturer   String            @default("ABB")
  /// Režim poslední analýzy fotky: "GEMINI" | "DEMO" (null = zatím neanalyzováno).
  analysisMode           String?
  /// Stav zakrytování z poslední analýzy: "UNCOVERED" (vidět šroubky svorek) | "COVERED" (čelní maska).
  coverState             String?
  /// Hlavní přívod rozváděče (fáze 42): "TOP" = přívod shora, "BOTTOM" = zespoda.
  incomerFrom            String            @default("TOP")
  /// Režim projektu (fáze 43): "PHOTO" = pasportizace z fotky, "DESIGN" = návrh od nuly bez fotky.
  designMode             String            @default("PHOTO")
  /// Kapacita jednotlivých DIN lišt v modulech, JSON pole [12, 14, …]; null = všechny `modulesPerRail`.
  railModulesJson        String?
  /// Vybraná skříň z katalogu rozvodnic a její max. ztrátový výkon P_max [W].
  enclosureId            String?
  enclosurePmaxW         Float?
  /**
   * Prostředí instalace dle ČSN 33 2000-5-51 ed. 3 (fáze 45): INDOOR_DRY | GARAGE | OUTDOOR | TIMBER | HOT.
   */
  environment            String            @default("INDOOR_DRY")
  /// Fáze 57: kdy uživatel výslovně zvolil / potvrdil prostředí (bez potvrzení nelze tisknout ani propustit dokumentaci).
  environmentConfirmedAt DateTime?
  /// Edice normy rozváděče (fáze 46): CSN_61439_3_ED2 (DBO) | CSN_61439_2_ED3 (PSC) | CSN_60204_1_ED3 (stroje, EU 2023/1230).
  standardEdition        String            @default("CSN_61439_3_ED2")
  /// Protokol o kusové zkoušce dle čl. 11 ČSN EN IEC 61439-1 ed. 3 – JSON (8 bodů, R_iso, zkoušející, datum).
  routineTestJson        String?
  /// Detailní fotky jednotlivých DIN lišt / sekcí (fáze 47) – JSON { "1": "/api/files/photos/…" }.
  railPhotosJson         String?
  /// Ventilátor rozváděče (nucené chlazení) a počet kusů (fáze 47).
  fanId                  String?
  fanCount               Int               @default(1)
  /// 2D půdorys elektroinstalace (fáze 49) – nákres editoru, ze kterého projekt vznikl (JSON `FloorplanDraft`).
  floorplanJson          String?
  /// Výkaz kabeláže z půdorysu (fáze 49) – 3 režimy vedení, rozpis kabelů, ΔU okruhů (JSON) pro dokumentaci.
  cableReportJson        String?
  /// Fáze 74: rozváděč z půdorysu s podružnými rozváděči – kód rozváděče („RH“ / „RP1“), u podružného id projektu
  /// hlavního rozváděče (bez cizího klíče – smazání hlavního rozváděče podružný nezruší) a jeho přívod (JSON `FeederInfo`).
  boardCode              String?
  parentBoardId          String?
  feederJson             String?

  createdById String?
  /// Registrovaná firma (fáze 41): vidí jen své rozváděče, její údaje se propisují do dokumentace.
  companyId   String?
  releasedAt  DateTime? // propuštění dokumentace do provozu
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  equipment  Equipment?         @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  company    RegisteredCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  enclosure  PanelEnclosure?    @relation(fields: [enclosureId], references: [id], onDelete: SetNull)
  fan        EnclosureFan?      @relation(fields: [fanId], references: [id], onDelete: SetNull)
  items      PanelBoardItem[]
  feedback   AiFeedbackReport[]
  /// Fáze 64: půdorysy, ze kterých byl rozváděč naposledy vygenerován.
  floorplans Floorplan[]

  @@index([equipmentId])
  @@index([companyId, updatedAt])
  @@index([enclosureId])
  @@index([parentBoardId])
}

/// Důvod snímku v historii verzí půdorysu (fáze 64).
enum FloorplanVersionReason {
  AUTO // průběžné ukládání – nejvýš jeden snímek za 10 minut
  MANUAL // „Uložit verzi“ s vlastním popisem
  GENERATE // stav, ze kterého byl vygenerován rozváděč
  RESTORE // stav před obnovením starší verze
  CONFLICT // změny z jiného okna odmítnuté kvůli souběhu
  OVERWRITE // verze přepsaná volbou „Ponechat mou verzi“
  IMPORT // převzato z prohlížeče nebo z hotového projektu
}

/// 2D půdorys elektroinstalace uložený na serveru (fáze 64) – rozpracovaný nákres editoru patřící firmě.
model Floorplan {
  id               String    @id @default(cuid())
  companyId        String
  /// Fáze 78: kód půdorysu ve firmě „FP-001“ (v pořadí založení, i v koši – neopakuje se).
  code             String?
  name             String
  customerName     String?
  installationSite String?
  /// Nákres editoru (JSON `FloorplanDraft`).
  draftJson        String
  /// Číslo uložené verze – ochrana proti přepsání z jiného okna (optimistické zamykání).
  version          Int       @default(1)
  /// Souhrn pro seznam půdorysů.
  elementCount     Int       @default(0)
  roomCount        Int       @default(0)
  floorCount       Int       @default(1)
  /// Poslední rozváděč vygenerovaný z půdorysu.
  projectId        String?
  /// Smazaný půdorys (koš) – jde obnovit.
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company  RegisteredCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project  PanelBoardProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions FloorplanVersion[]

  @@unique([companyId, code])
  @@index([companyId, deletedAt, updatedAt])
  @@index([projectId])
}

/// Snímek nákresu v historii verzí půdorysu (fáze 64).
model FloorplanVersion {
  id           String                 @id @default(cuid())
  floorplanId  String
  /// Číslo verze půdorysu, ke které snímek patří.
  version      Int
  reason       FloorplanVersionReason
  label        String?
  draftJson    String
  elementCount Int                    @default(0)
  createdAt    DateTime               @default(now())

  floorplan Floorplan @relation(fields: [floorplanId], references: [id], onDelete: Cascade)

  @@index([floorplanId, createdAt])
}

/// Skříň rozváděče / rozvodnice z katalogu (fáze 43) – filtruje se podle počtu řad a modulů návrhu.
model PanelEnclosure {
  id            String   @id @default(cuid())
  manufacturer  String // "ABB", "Eaton", "Hager" …
  series        String // "Mistral41W", "KLV", "Volta"
  model         String // "Mistral41W 36M 3×12" / "KLV-36UPS-F"
  articleNumber String   @unique
  rows          Int // počet řad (DIN lišt)
  modulesPerRow Int
  totalModules  Int
  widthMm       Int
  heightMm      Int
  depthMm       Int
  ipRating      String // "IP41"
  /// "FLUSH" (pod omítku) | "SURFACE" (na omítku) | "HOLLOW_WALL" | "FLOOR"
  installation  String
  /// "PLASTIC" | "PAINTED_STEEL" | "STAINLESS_STEEL"
  material      String   @default("PLASTIC")
  /// Max. ztrátový výkon skříně P_max [W] (výrobce, ΔT 35 K) – null = neuveden.
  pMaxW         Float?
  /// "STANDARD_MATRIX" (orientační matice Eldocku) | "EXTERNAL" (databáze ai-panel-builder)
  dataSource    String   @default("STANDARD_MATRIX")
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects PanelBoardProject[]

  @@index([manufacturer, rows, modulesPerRow])
}

/// Vazba katalogových kusů (fáze 43): příslušenství k přístroji (boční 0,5M kontakt, spoušť, hřeben, vložka).
model CatalogRelation {
  id           String  @id @default(cuid())
  parentId     String
  childId      String
  /// SIDE_LEFT | SIDE_RIGHT | SIDE_UNSPECIFIED | REQUIRES_BOM_ITEM | COMPATIBLE_BUSBAR | ACCESSORY
  relationType String
  qty          Float   @default(1)
  /// "catalog" = uvedeno v katalogu výrobce, "derived" = inženýrské odvození (neověřeno)
  basis        String  @default("catalog")
  verified     Boolean @default(false)
  note         String?

  parent CatalogComponent @relation("CatalogRelationParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  CatalogComponent @relation("CatalogRelationChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId, relationType])
  @@index([childId])
}

/// Konkrétní prvek osazený v rozváděči.
model PanelBoardItem {
  id                 String            @id @default(cuid())
  projectId          String
  catalogComponentId String?
  dinRailIndex       Int // 1..N shora
  positionOnRail     Int // pořadí zleva
  modulesWidth       Float
  boundingBoxJson    String? // [ymin, xmin, ymax, xmax] v % fotky
  recognitionStatus  RecognitionStatus @default(UNRECOGNIZED)
  confidence         Float             @default(0)
  rawOcrText         String?
  /// Odhad z analýzy fotky (kategorie, póly, proud, charakteristika) – předvyplní picker.
  detectedJson       String?
  /// Konfigurace z konfigurátoru (kategorie, výrobce, póly, In, char., typ chrániče …) – JSON.
  configJson         String?
  /// Ruční typové označení (přebije typ z katalogu v pracovní ploše i dokumentaci).
  customTypeCode     String?
  designation        String // IEC značení "-Q1", "-F1" …
  circuitLabel       String            @default("") // „Tepelné čerpadlo“, „Zásuvky kuchyně“
  phaseAssignment    String? // "L1,L2,L3,N" | "L1,L2,L3" | "L1" | "L2" | "L3"
  operatingCurrentA  Float? // výpočtový proud obvodu Ib [A]
  parentItemId       String? // nadřazený prvek ve stromu zapojení
  /// Napájeno přímo ze vstupu (kořen stromu). Bez rodiče a bez vstupu = nezapojeno.
  fedFromIncomer     Boolean           @default(false)
  sortOrder          Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project          PanelBoardProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  catalogComponent CatalogComponent? @relation(fields: [catalogComponentId], references: [id], onDelete: SetNull)
  parent           PanelBoardItem?   @relation("PanelTree", fields: [parentItemId], references: [id], onDelete: SetNull)
  children         PanelBoardItem[]  @relation("PanelTree")
  wiringDevices    PanelItemWiring[]

  @@index([projectId, dinRailIndex, positionOnRail])
  @@index([catalogComponentId])
  @@index([parentItemId])
}

// -----------------------------------------------------------------------------
//  LEGISLATIVNÍ PAKET 2027 (fáze 46) – knihovna návodů a verzované zálohy SW
// -----------------------------------------------------------------------------

enum AttachmentCategory {
  MANUAL // Návod k obsluze a údržbě
  DATASHEET // Katalogový list / datasheet dílu
  DRIVE_PARAMS // Manuál a chybové kódy měniče / pohonu
  FLUID_SCHEMA // Schéma hydrauliky / pneumatiky
  CERTIFICATE // Certifikát / ATEX / prohlášení o shodě
  OTHER
}

enum SoftwareBackupStatus {
  ACTIVE // aktuálně ve stroji
  ARCHIVED // starší záloha pro rollback
}

enum SafetyImpactLevel {
  NONE_1_TO_1 // běžná údržba, výměna kus za kus
  OPERATIONAL_ONLY // provozní úprava bez vlivu na bezpečnost
  SUBSTANTIAL_SAFETY_MOD // zásah do bezpečnostního obvodu – podstatná změna dle čl. 18 Nařízení (EU) 2023/1230
}

/// Návod, datasheet nebo technická příloha zařízení (volitelně navázaná na prvek schématu -U1, -K4 …).
model EquipmentDocument {
  id            String             @id @default(cuid())
  equipmentId   String
  category      AttachmentCategory
  title         String
  componentTag  String? // "-U1", "-A1", "-K4" – vazba na prvek ve schématu
  manufacturer  String?
  modelNumber   String?
  version       String             @default("1.0")
  language      String             @default("cs")
  fileUrl       String
  fileName      String
  fileSizeBytes Int
  uploadedById  String?
  createdAt     DateTime           @default(now())

  equipment  Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([equipmentId, category])
  @@index([equipmentId, componentTag])
}

/// Verzovaná záloha řídicího SW / parametrů (PLC, HMI, robot, měnič) – jeden ACTIVE na řídicí uzel.
model SoftwareBackup {
  id              String               @id @default(cuid())
  equipmentId     String
  targetUnit      String // "PLC -A1 (Siemens S7-1500)", "Frekvenční měnič -U1"
  platform        String // "TIA Portal V19", "Codesys", "Parametry měniče VFD"
  major           Int
  minor           Int
  status          SoftwareBackupStatus @default(ACTIVE)
  /// Evidence firmwaru dle Cyber Resilience Act (EU) 2024/2847.
  firmwareVersion String?
  /// Bezpečnostní logika dle Nařízení (EU) 2023/1230 (Safety PLC / F-CPU).
  isSafetyRelated Boolean              @default(false)
  safetyChecksum  String? // "CRC: 0x8F4A-2C91" / F-Signature
  changeSummary   String
  fileUrl         String
  fileName        String
  fileSizeBytes   Int
  changeRequestId String?
  authorId        String?
  createdAt       DateTime             @default(now())

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  author        User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([equipmentId, targetUnit, major, minor])
  @@index([equipmentId, targetUnit, status])
  @@index([changeRequestId])
}

