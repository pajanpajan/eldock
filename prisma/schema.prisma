/// Stav objednávky kreditů AI Panel Builderu (fáze 50).
enum CreditOrderStatus {
  PENDING // čeká na úhradu
  PAID // uhrazeno, kredity připsány
  CANCELLED // stornováno
}

/// Objednávka balíčku kreditů (fáze 50): QR platba SPD + zálohová faktura, potvrzení úhrady ve velínu /superadmin.
model CreditOrder {
  id              String            @id @default(cuid())
  companyId       String
  /// Variabilní symbol "RRRRNNNN" (rok + pořadí), jednoznačný napříč objednávkami.
  variableSymbol  String            @unique
  /// START_10 | PROFI_30 | UNLIMITED_YEAR
  packageCode     String
  creditsCount    Int
  priceCzkExclVat Int
  priceCzkInclVat Int
  status          CreditOrderStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime          @default(now())

  company RegisteredCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([status])
}

/// Hlášení chyby AI rozpoznání od testera (fáze 50) – snímek lišt a prvků v okamžiku hlášení.
model AiFeedbackReport {
  id                   String   @id @default(cuid())
  projectId            String?
  companyId            String?
  photoUrl             String?
  detectedSnapshotJson String
  message              String
  /// OPEN | RESOLVED
  status               String   @default("OPEN")
  adminNote            String?
  createdAt            DateTime @default(now())

  project PanelBoardProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  company RegisteredCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([projectId])
  @@index([companyId])
}

/// Kategorie opotřebení sledované součástky (fáze 53).
enum ComponentWearCategory {
  SWITCHING_CONTACTOR // silový stykač / relé / ventil – počet sepnutí
  SAFETY_ELEMENT // bezpečnostní prvek ČSN EN ISO 13849-1 – B10d a doba mise T_M
  POWER_ELECTRONICS // zdroj 24 V DC / měnič / kondenzátory – motohodiny + Arrhenius
  COOLING_FAN_FILTER // ventilátor / filtrační vložka / baterie UPS a PLC
}

/// Sledovaná kritická součástka s omezenou životností (fáze 53, prediktivní údržba).
model MonitoredComponent {
  id                    String                @id @default(cuid())
  equipmentId           String
  designation           String // "-K4", "-T1", "-U1"
  name                  String
  manufacturer          String?
  modelNumber           String?
  wearCategory          ComponentWearCategory
  installedAt           DateTime // instalace nebo poslední výměna kusu
  cyclesPerHour         Float?
  manualCyclesOffset    Int                   @default(0)
  maxElectricalCycles   Int? // AC-3 / AC-4 nebo B10d
  maxOperatingHours     Int? // při referenční teplotě 40 °C
  maxCalendarMonths     Int? // T_M, filtr, baterie
  replacementStockCount Int                   @default(0)
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

/// Fáze 56: záznam souhlasu s volitelnými cookies (čl. 7 odst. 1 GDPR – prokázání souhlasu). Bez IP adresy
/// a bez vazby na účet; `consentId` je náhodný identifikátor uložený v cookie `eldock_consent`.
model ConsentRecord {
  id        String   @id @default(cuid())
  consentId String
  version   Int
  analytics Boolean
  marketing Boolean
  /// banner | settings
  source    String
  createdAt DateTime @default(now())

  @@index([consentId, createdAt])
}

/// Stav odběratele newsletteru (double opt-in).
enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

/// Fáze 56: odběratel měsíčního newsletteru. Souhlas (text, verze, čas) se ukládá kvůli prokázání (čl. 7 GDPR);
/// potvrzovací token jen jako otisk SHA-256.
model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           NewsletterStatus @default(PENDING)
  /// elektrikar | revizni-technik | technicky-reditel | udrzba | jine
  audience         String?
  source           String           @default("web")
  consentText      String
  consentVersion   String
  consentAt        DateTime         @default(now())
  confirmTokenHash String?          @unique
  confirmSentAt    DateTime?
  confirmedAt      DateTime?
  unsubscribeToken String           @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, audience])
}

/// Fáze 56: rozeslané vydání newsletteru (cca 1× měsíčně).
model NewsletterIssue {
  id         String    @id @default(cuid())
  subject    String
  body       String
  /// null = všem potvrzeným, jinak jen dané cílové skupině
  audience   String?
  recipients Int       @default(0)
  failed     Int       @default(0)
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}

// -----------------------------------------------------------------------------
//  ÚLOŽIŠTĚ SOUBORŮ, ZÁLOHY A RETENCE (fáze 68)
// -----------------------------------------------------------------------------

/// Vlastník nahraného souboru – rozhoduje, kdo ho smí číst (`GET /api/files`) a převzít do svého záznamu.
enum FileOwnerKind {
  DEMO // obchodní demo (účty bez firmy) – čtou ho jen demo účty
  COMPANY // registrovaná firma (Správa závodů i AI Panel Builder) – čtou ho jen její přihlášení
  SHARED // starší soubor s odkazy více vlastníků nebo z tabulky bez vlastníka – čte ho každé přihlášení (jako před fází 68)
}

/// Registr nahraných souborů (fáze 68): vlastník, velikost a otisk. Vzorové soubory ze složek `seed/` v registru nejsou.
model StoredFile {
  id           String        @id @default(cuid())
  /// Adresa v aplikaci `/api/files/<druh>/<soubor>`.
  url          String        @unique
  /// Složka úložiště (photos, documents, …).
  kind         String
  ownerKind    FileOwnerKind
  /// Registrovaná firma (`RegisteredCompany.id`) u vlastníka COMPANY.
  companyId    String?
  /// Uživatel Správy závodů, který soubor nahrál (Panel Builder a soubory vytvořené serverem bez autora).
  uploadedById String?
  sizeBytes    Int
  sha256       String?
  mimeType     String
  originalName String?
  /// upload = POST /api/uploads · server = vytvořil server (zpráva, revize) · registry = doplněno `npm run storage:registry`
  source       String        @default("upload")
  createdAt    DateTime      @default(now())
  /// Soubor smazaný z úložiště (úklid, smazání projektu) – číst nejde, záloha mimo server ho smaže po 30 dnech.
  deletedAt    DateTime?

  @@index([companyId])
  @@index([ownerKind])
}

enum MaintenanceKind {
  BACKUP // snímek databáze + soubory mimo server
  RETENTION // úklid bezpečnostního deníku, relací a odkazů na heslo
  ERASURE // fáze 69: výmaz účtů firem po uplynutí lhůty
}

enum MaintenanceTrigger {
  SCHEDULE // denní plánovač v procesu aplikace
  MANUAL // „Zálohovat teď“ ve velínu
  CLI // npm run backup
}

enum MaintenanceStatus {
  RUNNING
  OK
  WARNING // dokončeno, ale část se nepovedla (např. některé soubory mimo server)
  FAILED
}

/// Běh údržby (fáze 68) – velín z něj ukazuje stav záloh, plánovač podle něj pozná, že dnešní záloha už proběhla.
model MaintenanceRun {
  id          String             @id @default(cuid())
  kind        MaintenanceKind
  trigger     MaintenanceTrigger
  status      MaintenanceStatus  @default(RUNNING)
  startedAt   DateTime           @default(now())
  finishedAt  DateTime?
  /// Souhrn běhu (JSON): velikost snímku, soubory mimo server, smazané záznamy…
  summaryJson String?
  error       String?

  @@index([kind, startedAt])
}

/// Objekt zálohy mimo server (úložiště S3): šifrovaný snímek databáze nebo soubor úložiště.
model BackupObject {
  /// Klíč objektu v úložišti (s prefixem `ELDOCK_BACKUP_S3_PREFIX`): `eldock/db/eldock-20261108T013000Z.db.gz.enc`, `eldock/files/photos/<soubor>.enc`
  key           String    @id
  /// db | file
  kind          String
  /// Soubor úložiště (`photos/<soubor>`, `documents/seed/<soubor>`), u snímku databáze jeho název.
  source        String
  sizeBytes     Int
  storedBytes   Int
  sha256        String?
  /// Čas změny zdrojového souboru (ms) – přepsaný vzorový soubor se nahraje znovu.
  sourceMtimeMs Float?
  uploadedAt    DateTime  @default(now())
  /// Zdroj zmizel z úložiště (smazání v aplikaci) – objekt se smaže po 30 dnech.
  missingSince  DateTime?

  @@index([kind, uploadedAt])
  @@index([source])
}

// -----------------------------------------------------------------------------
//  ŽÁDOSTI O DATA – EXPORT A VÝMAZ (fáze 69, GDPR)
// -----------------------------------------------------------------------------

enum DataRequestKind {
  COMPANY_EXPORT // export dat firmy (čl. 20 GDPR, vrácení dat zpracovatelem)
  PERSONAL_EXPORT // vlastní údaje uživatele (čl. 15 GDPR)
  COMPANY_CLOSURE // zrušení účtu firmy a výmaz dat po lhůtě (čl. 17, čl. 28 odst. 3 písm. g)
  USER_REMOVAL // odebrání zaměstnance s anonymizací účtu
}

enum DataRequestStatus {
  PENDING // čeká na lhůtu (zrušení účtu firmy) – do té doby jde zrušit
  DONE
  CANCELLED
  FAILED
}

/// Evidence žádostí o data (fáze 69): export, odebrání zaměstnance, zrušení účtu firmy. Bez osobních údajů – jen firma
/// (název, IČO), kdo žádost podal (role, ne jméno), časy a souhrn; slouží jako doklad o vyřízení (čl. 5 odst. 2 GDPR)
/// a plánovač podle ní provede výmaz po lhůtě. Drží se 3 roky.
model DataRequest {
  id           String            @id @default(cuid())
  kind         DataRequestKind
  status       DataRequestStatus @default(DONE)
  companyId    String?
  companyName  String?
  companyIco   String?
  productScope ProductScope?
  /// company-admin | panel-company | superadmin | user
  requestedBy  String
  requestedAt  DateTime          @default(now())
  /// Zrušení účtu firmy: kdy proběhne výmaz (žádost + 30 dní)
  scheduledAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  /// Souhrn (JSON): počty exportovaných / smazaných záznamů a souborů
  summaryJson  String?
  error        String?

  @@index([kind, status, scheduledAt])
  @@index([companyId, kind])
}

// -----------------------------------------------------------------------------
//  SYNCHRONIZACE S APLIKACEMI (fáze 70) – Windows, iOS, Android, server závodu
// -----------------------------------------------------------------------------

enum SyncPlatform {
  WINDOWS
  IOS
  ANDROID
  PLANT_SERVER // server závodu (fáze 72) – synchronizuje celý závod pro interní síť a přeposílá úpravy z haly
  OTHER
}

/// Fáze 72: k čemu kód párování slouží – server závodu spáruje jen kód od správce firmy.
enum SyncPairingPurpose {
  DEVICE // aplikace (Windows, iOS, Android) – Můj účet
  PLANT_SERVER // server závodu – Administrace → Zařízení, jen správce firmy
}

enum SyncMutationStatus {
  APPLIED // úprava provedena
  REJECTED // úprava odmítnuta pravidlem (oprávnění, stav záznamu, souběh) – aplikace ji znovu neposílá
}

/// Spárovaná aplikace uživatele registrované firmy. Token zařízení je jen v aplikaci, v DB jeho SHA-256.
/// Platí do odpojení; po `SYNC_POLICY.idleExpiryDays` dnech bez spojení vyprší (lib/sync.ts).
model SyncDevice {
  id            String       @id @default(cuid())
  userId        String
  companyId     String
  /// Název od uživatele / z aplikace („iPhone – Petr“, „Tablet údržby hala A“)
  name          String
  platform      SyncPlatform
  appVersion    String?
  tokenHash     String       @unique
  createdAt     DateTime     @default(now())
  lastSeenAt    DateTime     @default(now())
  /// Poslední úspěšné stažení změn (každodenní synchronizace) a odeslání fronty úprav
  lastPullAt    DateTime?
  lastPushAt    DateTime?
  /// Kurzor žurnálu po posledním stažení (kolik změn má zařízení staženo)
  lastCursor    Int?
  revokedAt     DateTime?
  revokedById   String?
  /// Důvod odpojení: uživatel, správce firmy, změna hesla, blokace…
  revokedReason String?

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mutations SyncMutation[]

  @@index([userId, revokedAt])
  @@index([companyId, revokedAt])
}

/// Jednorázový kód párování z „Můj účet“ (10 minut). V DB jen HMAC kódu.
model SyncPairing {
  id        String             @id @default(cuid())
  userId    String
  codeHash  String             @unique
  purpose   SyncPairingPurpose @default(DEVICE)
  expiresAt DateTime
  usedAt    DateTime?
  deviceId  String?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Evidence úprav z aplikací (fronta offline): id úpravy z aplikace je unikátní pro uživatele → každá úprava
/// proběhne přesně jednou i při opakovaném odeslání. Zapisuje se v jedné transakci se samotnou úpravou.
model SyncMutation {
  id          String             @id @default(cuid())
  userId      String
  deviceId    String?
  /// Id úpravy přidělené aplikací (UUID)
  clientId    String
  /// Druh úpravy (`changeRequest.submit`, `defect.resolve` … – server/sync/mutations.ts)
  type        String
  status      SyncMutationStatus
  /// Kód odmítnutí (NOT_FOUND, FORBIDDEN, CONFLICT, INVALID_STATE, VALIDATION, DUPLICATE_ID)
  code        String?
  message     String?
  /// Záznam, který úprava vytvořila nebo změnila
  entity      String?
  entityId    String?
  resultJson  String?
  /// Kdy úpravu provedl uživatel v aplikaci (offline) a kdy ji server přijal
  performedAt DateTime?
  receivedAt  DateTime           @default(now())

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device SyncDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([deviceId, receivedAt])
  @@index([receivedAt])
}

/// Žurnál změn (fáze 70): jeden řádek na synchronizovaný záznam s pořadím poslední změny. Zapisují ho jen triggery
/// SQLite (`server/sync/journal.ts`, `ensureSyncTriggers`) – rozsah (závod, zařízení, firma) se dědí ze žurnálu rodiče.
/// Smazaný záznam = `deleted` (značka se drží 90 dní). Bez osobních údajů.
model SyncChange {
  entity      String
  entityId    String
  plantId     String?
  companyId   String?
  /// Zařízení, pod které záznam patří (výřez kategorií účtu)
  equipmentId String?
  seq         Int
  deleted     Boolean  @default(false)
  changedAt   DateTime

  @@id([entity, entityId])
  @@index([plantId, seq])
  @@index([companyId, seq])
  @@index([equipmentId])
  @@index([deleted, changedAt])
}

/// Čítač žurnálu (jediný řádek id = 1): `value` = poslední přidělené `seq`, `prunedSeq` = nejvyšší `seq` smazané
/// značky – starší kurzor zařízení musí stáhnout vše znovu (`reset`).
model SyncCounter {
  id        Int @id
  value     Int @default(0)
  prunedSeq Int @default(0)
}
