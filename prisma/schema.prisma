// =============================================================================
//  Eldock – Industrial Electrical Documentation & Maintenance Twin (MVP)
//  Prisma schema · SQLite (dev) → PostgreSQL (prod)
//
//  Cílová verze: Prisma ORM 7.x
//  - Connection string (DATABASE_URL) je v /prisma.config.ts, ne ve schématu.
//  - Runtime klient se připojuje přes driver adapter
//    (@prisma/adapter-better-sqlite3 → později @prisma/adapter-pg).
//  - Vygenerovaný klient: src/generated/prisma (import z "@/generated/prisma/client").
//  - Strukturovaná data (redline tahy, SVG polygony) jsou uložena jako String
//    se serializovaným JSON/SVG obsahem, aby schéma fungovalo shodně
//    na SQLite i PostgreSQL. Při migraci na PostgreSQL lze přepnout na Json.
//  - Souřadnice pinů a map jsou v procentech (0–100) vůči viewBoxu podkladu,
//    takže nezávisí na rozlišení obrázku/SVG.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// -----------------------------------------------------------------------------
//  ENUMY
// -----------------------------------------------------------------------------

/// Role uživatele – odpovídá přepínači pohledu v navbaru.
enum UserRole {
  MAINTENANCE // Pohled: Údržba v hale
  CAE_ENGINEER // Pohled: CAE Projektant
  ADMIN
}

/// Typ účtu (výřez dat a oprávnění). Workflow role se z něj odvozuje (lib/accounts.ts).
enum AccountType {
  PLANT_ADMIN // Technický ředitel – vše, KPI, audit, studio, správa účtů
  MAINTENANCE_LEAD // Vedoucí údržby – vše, schvaluje revize, LOTO, provizoria, závady
  MAINTENANCE_TECH // Směnový údržbář – pevná zařízení, zadává změny a provizoria
  INSPECTOR_VTZ // Revizní technik VTZ – jen vyhrazená technická zařízení
  INSPECTOR_APPLIANCES // Technik revizí spotřebičů – jen spotřebiče a nářadí
  CAE_ENGINEER // CAE projektant – výkresová dokumentace a požadavky na změnu
}

/// Stav dokumentace zařízení = barva pinu na půdorysu.
enum EquipmentStatus {
  ACTIVE // 🟢 dokumentace 100% aktuální
  PENDING_UPDATE // 🟠 nahlášena změna, CAE na ní pracuje
  WAITING_APPROVAL // 🔵 CAE nahrál novou revizi, čeká na potvrzení údržbou
}

enum EquipmentType {
  // Pevná infrastruktura (schéma, kusovník, 3D)
  SWITCHBOARD // Rozváděč
  TRANSFORMER // Transformátor / trafostanice
  PRODUCTION_LINE // Výrobní linka
  MACHINE // Pevný stroj
  CNC_MACHINE // CNC stroj
  ROBOT_CELL // Robotické pracoviště
  HVAC_UNIT // Vzduchotechnika
  COMPRESSOR // Kompresor
  // Spotřebiče a revizní zařízení (lehká karta bez schématu a 3D)
  POWER_TOOL // Ruční elektrické nářadí
  APPLIANCE // Spotřebič (konvice, mikrovlnka, PC)
  EXTENSION_CORD // Prodlužovací přívod
  WELDER // Svářečka
  LIGHTNING_ROD // Hromosvod / LPS
  EMERGENCY_LIGHTING // Nouzové osvětlení
  OTHER
}

enum BuildingType {
  PRODUCTION // Výrobní hala
  ASSEMBLY // Montáž
  ENERGY // Energetika
  WAREHOUSE // Sklad
  OFFICE // Administrativa
  OTHER
}

/// Životní cyklus revize dokumentace.
enum RevisionStatus {
  PENDING_APPROVAL // nahraná CAE, čeká na potvrzení údržbou
  ACTIVE // aktuálně platná (max. 1 na zařízení – hlídá aplikační logika)
  ARCHIVED // nahrazená novější revizí → Historie změn
  REJECTED // vrácena k přepracování
}

enum SchematicFormat {
  PDF
  SVG
  IMAGE
}

/// Stavový automat požadavku na změnu (Zadat změnu).
enum ChangeRequestStatus {
  SUBMITTED // technik odeslal, ticket v CAE back-office
  IN_PROGRESS // CAE projektant převzal / přepracovává
  WAITING_APPROVAL // nová revize nahrána, čeká na údržbu
  APPROVED // potvrzeno a propsáno do systému (uzavřeno)
  CANCELLED // stornováno
}

enum ChangeRequestPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL // bezpečnostně relevantní změna
}

enum AttachmentType {
  PHOTO // fotodokumentace z haly
  VOICE_NOTE // audio záznam (simulovaný)
  MARKUP_IMAGE // export redline vrstvy jako PNG
  OTHER
}

/// Auditní stopa změn ticketu (timeline v detailu ticketu).
enum ChangeRequestEventType {
  SUBMITTED
  ASSIGNED
  REVISION_UPLOADED
  APPROVED
  REJECTED
  COMMENT
  CANCELLED
}

/// Výrobní dokumentace rozváděče dle ČSN EN 61439 (Pasport & Shoda).
enum ComplianceCategory {
  SINGLE_LINE_DIAGRAM // Liniové schéma
  CONFORMITY_DECLARATION // EU prohlášení o shodě
  ROUTINE_VERIFICATION // Kusová zkouška (čl. 11)
  THERMAL_CALCULATION // Ověření oteplení výpočtem (čl. 10.10.4)
  EXTERNAL_INFLUENCES // Protokol o určení vnějších vlivů
}

/// Druh revize elektrického zařízení dle ČSN 33 1500.
enum InspectionType {
  INITIAL // Výchozí revize
  PERIODIC // Pravidelná revize
  EXTRAORDINARY // Mimořádná revize
  THERMOVISION // Termovizní měření (doplňkové, nepočítá se do lhůty)
}

/// Celkový posudek revizní zprávy.
enum InspectionResult {
  CAPABLE // Schopno bezpečného provozu
  CAPABLE_WITH_DEFECTS // Schopno bezpečného provozu s výhradou
  INCAPABLE // Neschopno bezpečného provozu
}

/// Dočasné provizorium v zařízení (nemění oficiální dokumentaci).
enum TemporaryModStatus {
  ACTIVE // aktivní provizorium – varuje obsluhu
  RESTORED_1_TO_1 // odstraněno, vráceno do stavu 1:1 dle schématu
  CONVERTED_TO_CR // odstraněno, finální stav se liší → požadavek na změnu dokumentace
}

/// Závažnost revizní závady (lhůta odstranění).
enum DefectSeverity {
  MINOR // drobná – do 90 dnů
  MAJOR // závažná – do 30 dnů
  CRITICAL // kritická – ihned, zařízení mimo provoz
}

enum DefectStatus {
  OPEN
  RESOLVED
}

// -----------------------------------------------------------------------------
//  UŽIVATELÉ
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  company   String? // např. "Závod Jablonec – Údržba" / "Eldock CAE"
  phone     String?
  avatarUrl String?

  // Účet v aplikaci (null = historický uživatel bez přihlášení, např. autor starých revizí)
  accountType AccountType?
  title       String? // „Technický ředitel“
  scopeLayers String? // vlastní výřez kategorií (klíče vrstev mapy oddělené čárkou); null = výchozí pro typ účtu
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  authoredRevisions      DocumentRevision[]   @relation("RevisionAuthor")
  approvedRevisions      DocumentRevision[]   @relation("RevisionApprover")
  reportedChangeRequests ChangeRequest[]      @relation("ChangeRequestReporter")
  assignedChangeRequests ChangeRequest[]      @relation("ChangeRequestAssignee")
  changeRequestEvents    ChangeRequestEvent[]
  uploadedAttachments    Attachment[]

  @@index([role])
  @@index([accountType])
}

// -----------------------------------------------------------------------------
//  LOKALITY – 3úrovňová mapa (Areál → Budova/Patro → Půdorys)
// -----------------------------------------------------------------------------

/// Level 1 – Závod / areál klienta.
model Plant {
  id           String  @id @default(cuid())
  code         String  @unique // např. "JBC"
  name         String // "Závod Jablonec"
  customerName String // název klientské firmy
  address      String?
  city         String?
  country      String  @default("CZ")

  // Podklad mapy areálu (SVG generované v aplikaci nebo nahraný obrázek)
  campusMapUrl   String?
  campusViewBoxW Int     @default(1000)
  campusViewBoxH Int     @default(700)
  // Skutečný rozměr pozemku v metrech (převod rozměru budovy ve Studiu na mapu)
  campusWidthM   Int     @default(400)
  campusDepthM   Int     @default(280)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buildings Building[]
}

/// Budova v areálu – klikací oblast v Campus View.
model Building {
  id          String       @id @default(cuid())
  plantId     String
  code        String // "A", "B", "E"
  name        String // "Hala A - Lisovna"
  shortName   String? // "Lisovna"
  type        BuildingType @default(PRODUCTION)
  description String?

  // Geometrie v Campus View (procenta vůči viewBoxu areálu)
  mapPolygon String // SVG points "x1,y1 x2,y2 ..." – obrys budovy
  labelX     Float // pozice štítku/badge
  labelY     Float
  color      String? // volitelný akcent (#hex)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant  Plant   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@unique([plantId, code])
  @@index([plantId])
}

/// Level 2/3 – Patro budovy (izometrický výběr + 2D půdorys).
model Floor {
  id          String  @id @default(cuid())
  buildingId  String
  level       Int // -1 = 1. PP, 0 = 1. NP, 1 = 2. NP …
  code        String // "1PP", "1NP", "2NP"
  name        String // "1. PP - Rozvodny"
  description String?

  // Level 3 – podklad půdorysu (SVG generované v aplikaci nebo nahraný soubor)
  floorplanUrl String?
  floorplanSvg String? // inline SVG půdorysu (mock grafika bez externích assetů)
  viewBoxW     Int     @default(1200)
  viewBoxH     Int     @default(800)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  building  Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  equipment Equipment[]

  @@unique([buildingId, level])
  @@unique([buildingId, code])
  @@index([buildingId])
}

// -----------------------------------------------------------------------------
//  ZAŘÍZENÍ (ASSET)
// -----------------------------------------------------------------------------

/// Elektrické zařízení – pin na půdorysu, cíl QR kódu /equipment/[id].
model Equipment {
  id          String          @id @default(cuid())
  floorId     String
  tag         String // označení dle dokumentace: "RM1", "R-CNC-04"
  name        String // "RM1 - Hlavní rozváděč"
  type        EquipmentType
  status      EquipmentStatus @default(ACTIVE)
  description String?

  manufacturer  String?
  model         String?
  serialNumber  String?
  yearInstalled Int?
  ratedVoltage  String? // "400 V AC / 50 Hz"
  ratedCurrent  String? // "1600 A"
  ipRating      String? // "IP54"

  // Pozice pinu na půdorysu patra (procenta 0–100)
  pinX Float
  pinY Float

  // Hierarchie napájení – ze kterého rozváděče a vývodu je zařízení napájeno
  fedFromEquipmentId String?
  fedFromCircuit     String? // "Pole 3 / Jistič QF4"

  // Pasport a lhůtník revizí
  inspectionIntervalMonths Int     @default(36) // lhůta pravidelné revize dle ČSN 33 1500
  externalInfluences       String? // "AA5, AB4, BA4 – normální průmyslové"

  // Spotřebiče a nářadí (ČSN 33 1600 ed. 2)
  usageGroup      String? // skupina A–E (C = průmysl, E = administrativa)
  protectionClass String? // třída ochrany "I" / "II" / "III"
  inventoryNumber String?
  assignedZone    String? // "Kuchyňka – Energetika 1. NP", "Dílna údržby"

  // Vizuální karta a QR štítek
  photoUrl String? // fotografie zařízení (/api/files/photos/…)
  qrToken  String? @unique // kód fyzického QR štítku – přegenerováním přestane starý štítek platit

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor               Floor                   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fedFrom             Equipment?              @relation("PowerFeed", fields: [fedFromEquipmentId], references: [id], onDelete: SetNull)
  feeds               Equipment[]             @relation("PowerFeed")
  revisions           DocumentRevision[]
  changeRequests      ChangeRequest[]
  complianceDocuments ComplianceDocument[]
  inspections         InspectionRecord[]
  schematicReferences SchematicReference[]    @relation("SchematicReferenceTarget")
  defects             InspectionDefect[]
  temporaryMods       TemporaryModification[]

  @@unique([floorId, tag])
  @@index([floorId])
  @@index([status])
  @@index([fedFromEquipmentId])
  @@index([type])
}

/// Dokument výrobní dokumentace rozváděče (ČSN EN 61439) – záložka Pasport & Shoda.
model ComplianceDocument {
  id             String             @id @default(cuid())
  equipmentId    String
  category       ComplianceCategory
  title          String
  documentNumber String
  fileUrl        String
  issuedAt       DateTime
  issuer         String // výrobce rozváděče / projektant
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, category])
}

/// Revizní zpráva nebo termovizní měření – záložka Revize & Lhůtník.
model InspectionRecord {
  id               String           @id @default(cuid())
  equipmentId      String
  type             InspectionType
  inspectionDate   DateTime
  validUntil       DateTime
  reportNumber     String
  inspectorName    String
  inspectorLicense String // ev. č. osvědčení TIČR dle NV 190/2022 Sb.
  result           InspectionResult
  defectsSummary   String?
  reportUrl        String

  // Měření (revize spotřebičů a nářadí)
  measuringInstrument           String? // "Metrel MI 3309 BT"
  protectiveConductorResistance Float? // R_PE [Ω]
  insulationResistance          Float? // R_iso [MΩ]
  leakageCurrent                Float? // unikající / rozdílový proud I_PE / I_Δ [mA]
  functionalTest                Boolean? // funkční zkouška vyhověla (null = neprováděla se)

  // Termovize
  maxTempC   Float? // nejvyšší naměřená teplota [°C]
  deltaTempC Float? // ΔT vůči okolí [K]

  defects   InspectionDefect[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, inspectionDate])
  @@index([validUntil])
  @@index([equipmentId, type, validUntil])
}

// -----------------------------------------------------------------------------
//  DOKUMENTACE – revize (aktivní + Historie změn)
// -----------------------------------------------------------------------------

/// Jedna revize elektrodokumentace zařízení (v1.0, v1.1, v2.0 …).
model DocumentRevision {
  id          String         @id @default(cuid())
  equipmentId String
  version     String // zobrazované "v1.2"
  major       Int // 1
  minor       Int // 2
  status      RevisionStatus @default(PENDING_APPROVAL)

  title   String // "Elektrické schéma rozváděče RM1"
  summary String? // technické shrnutí změn od CAE projektanta

  // Soubory
  schematicUrl    String // PDF/SVG/obrázek schématu
  schematicFormat SchematicFormat @default(PDF)
  sheetCount      Int             @default(1)
  thumbnailUrl    String?
  bomFileUrl      String? // export kusovníku (XLSX/CSV)
  layoutUrl       String? // dispozice rozváděče
  model3dUrl      String? // 3D náhled skříně (GLB)

  // Autor / schvalovatel
  authorId   String
  approverId String?
  approvedAt DateTime?

  // Odkud revize vznikla (null = výchozí digitalizace)
  changeRequestId  String?
  rejectionComment String? // důvod vrácení k přepracování

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  equipment     Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  author        User           @relation("RevisionAuthor", fields: [authorId], references: [id])
  approver      User?          @relation("RevisionApprover", fields: [approverId], references: [id])
  changeRequest ChangeRequest? @relation("ResolvingRevisions", fields: [changeRequestId], references: [id], onDelete: SetNull)

  bomItems            BomItem[]
  references          SchematicReference[]
  markedUpInRequests  ChangeRequest[]      @relation("BaseRevision")
  changeRequestEvents ChangeRequestEvent[]

  @@unique([equipmentId, major, minor])
  @@index([equipmentId, status])
  @@index([changeRequestId])
  @@index([authorId])
  @@index([approverId])
}

/// Položka kusovníku (BOM) dané revize.
model BomItem {
  id           String  @id @default(cuid())
  revisionId   String
  position     Int // pořadí v tabulce
  designation  String // označení ve schématu: "K4", "Q1", "F12"
  description  String // "Stykač 3P 25 A, cívka 24 V DC"
  manufacturer String?
  partNumber   String? // objednací číslo
  quantity     Float   @default(1)
  unit         String  @default("ks")
  note         String?

  revision DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([revisionId])
}

// -----------------------------------------------------------------------------
//  POŽADAVKY NA ZMĚNU (Zadat změnu → CAE → Schválení → Archiv)
// -----------------------------------------------------------------------------

/// Ticket "As-Built" změny nahlášený údržbou z haly.
model ChangeRequest {
  id          String                @id @default(cuid())
  number      String                @unique // "ZM-2026-0012"
  equipmentId String
  status      ChangeRequestStatus   @default(SUBMITTED)
  priority    ChangeRequestPriority @default(NORMAL)

  // Krok 1 – Redlining nad aktuálním schématem
  baseRevisionId String? // revize, nad kterou technik kreslil
  markupSheet    Int     @default(1) // číslo listu schématu
  markupData     String? // JSON: tahy pera [{points:[[x,y]...], color, width}]
  markupImageUrl String? // PNG export (schéma + červená vrstva)

  // Krok 3 – hlas / rychlá poznámka
  voiceTranscript String? // přepis hlasové poznámky
  note            String? // ručně psaná rychlá poznámka

  // Účastníci
  reporterId String
  assigneeId String? // CAE projektant

  // Odpověď CAE / výsledek
  engineerSummary String?

  submittedAt DateTime  @default(now())
  assignedAt  DateTime?
  resolvedAt  DateTime? // nahrání revize k potvrzení
  closedAt    DateTime? // schváleno / stornováno
  updatedAt   DateTime  @updatedAt

  equipment          Equipment               @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  baseRevision       DocumentRevision?       @relation("BaseRevision", fields: [baseRevisionId], references: [id], onDelete: SetNull)
  reporter           User                    @relation("ChangeRequestReporter", fields: [reporterId], references: [id])
  assignee           User?                   @relation("ChangeRequestAssignee", fields: [assigneeId], references: [id])
  resolvingRevisions DocumentRevision[]      @relation("ResolvingRevisions")
  attachments        Attachment[]
  events             ChangeRequestEvent[]
  temporaryMods      TemporaryModification[]

  @@index([equipmentId, status])
  @@index([status])
  @@index([assigneeId])
  @@index([reporterId])
  @@index([baseRevisionId])
  @@index([submittedAt])
}

/// Přílohy ticketu – fotky z haly (Krok 2), hlasové poznámky, export markupu.
model Attachment {
  id              String         @id @default(cuid())
  changeRequestId String
  type            AttachmentType
  url             String
  fileName        String?
  mimeType        String?
  sizeBytes       Int?
  caption         String?
  uploadedById    String
  createdAt       DateTime       @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  uploadedBy    User          @relation(fields: [uploadedById], references: [id])

  @@index([changeRequestId])
  @@index([uploadedById])
}

/// Timeline událostí ticketu (stavový automat + komentáře).
model ChangeRequestEvent {
  id              String                 @id @default(cuid())
  changeRequestId String
  type            ChangeRequestEventType
  actorId         String
  revisionId      String? // revize, které se událost týká
  fromStatus      ChangeRequestStatus?
  toStatus        ChangeRequestStatus?
  comment         String?
  createdAt       DateTime               @default(now())

  changeRequest ChangeRequest     @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  actor         User              @relation(fields: [actorId], references: [id])
  revision      DocumentRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)

  @@index([changeRequestId, createdAt])
  @@index([actorId])
  @@index([revisionId])
}

/// Závada z revizní zprávy – sleduje se až do odstranění.
model InspectionDefect {
  id                 String         @id @default(cuid())
  inspectionId       String
  equipmentId        String
  description        String
  severity           DefectSeverity @default(MAJOR)
  deadline           DateTime
  status             DefectStatus   @default(OPEN)
  resolvedAt         DateTime?
  resolvedBy         String?
  resolutionNote     String?
  resolutionPhotoUrl String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  inspection InspectionRecord @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  equipment  Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, status])
  @@index([inspectionId])
  @@index([status, deadline])
}

/// Dočasné provizorní zapojení (např. náhrada dílu čekající na dodávku) – do 7–14 dnů odstranit.
model TemporaryModification {
  id             String             @id @default(cuid())
  equipmentId    String
  number         String             @unique // "PROV-2026-0001"
  title          String
  description    String
  createdByName  String
  createdByRole  String // "Revizní technik" / "Údržba"
  createdAt      DateTime           @default(now())
  expiresAt      DateTime // povinný termín odstranění
  photoUrl       String?
  markupJson     String?
  status         TemporaryModStatus @default(ACTIVE)
  resolvedAt     DateTime?
  resolvedByName String?
  resolutionNote String?
  updatedAt      DateTime           @updatedAt

  spawnedChangeRequestId String?

  equipment            Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  spawnedChangeRequest ChangeRequest? @relation(fields: [spawnedChangeRequestId], references: [id], onDelete: SetNull)

  @@index([equipmentId, status])
  @@index([status, expiresAt])
  @@index([spawnedChangeRequestId])
}

/// Log odeslaných notifikací (souhrnné avízo lhůt revizí). Bez SMTP se e-mail jen uloží sem.
model NotificationLog {
  id          String   @id @default(cuid())
  kind        String // "INSPECTION_DIGEST"
  plantId     String?
  subject     String
  recipients  String // e-maily oddělené čárkou
  html        String
  text        String
  itemCount   Int
  delivery    String // "SENT" | "LOGGED" | "FAILED"
  error       String?
  triggeredBy String // "manual:<userId>" | "cron"
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
  @@index([kind, plantId, createdAt])
}

/// Interaktivní reference ve výkresu revize (CAE): značka prvku s pozicí na stránce a volitelnou
/// vazbou na kartu zařízení. Souřadnice v procentech stránky (levý okraj a účaří popisku).
model SchematicReference {
  id                String   @id @default(cuid())
  revisionId        String
  page              Int      @default(1)
  designation       String // "-Q1", "-M1"
  title             String // "Hlavní vypínač přívodu"
  description       String?
  x                 Float
  y                 Float
  linkedEquipmentId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  revision        DocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  linkedEquipment Equipment?       @relation("SchematicReferenceTarget", fields: [linkedEquipmentId], references: [id], onDelete: SetNull)

  @@index([revisionId, page])
  @@index([linkedEquipmentId])
}

/// Licenční moduly (add-ony nad Core) – globální konfigurace tenantu. Chybějící řádek = modul zapnutý.
model TenantModule {
  key         String   @id // "INSPECTIONS_PRO" | "CAE_ADVANCED" | "ENTERPRISE_TOOLS"
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Podfunkce licenčních modulů ("cae.visual_diff", "inspections.alerts" …). Účinná jen se zapnutým
/// modulem. Chybějící řádek = zapnuto.
model TenantFeature {
  key         String   @id
  enabled     Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Nastavení tenantu (klíč → hodnota), např. "modules.displayMode" = "CLEAN" | "UPSELL".
model TenantSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}
