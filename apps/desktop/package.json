{
  "name": "eldock-desktop",
  "productName": "Eldock",
  "version": "1.0.0",
  "private": true,
  "description": "Eldock pro Windows – offline aplikace údržby (fáze 71)",
  "author": "Eldock",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.5"
  }
}
