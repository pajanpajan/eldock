{
  "name": "eldock-client",
  "productName": "Eldock",
  "version": "1.0.0",
  "private": true,
  "description": "Eldock – offline aplikace údržby pro Windows (Electron, fáze 71), Android a iOS (Capacitor, fáze 73)",
  "author": "Eldock",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "mobile:sync": "vite build && cap sync",
    "android:apk": "npm run mobile:sync && node scripts/android-build.mjs assembleDebug",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "devDependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/network": "8.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.5"
  }
}
