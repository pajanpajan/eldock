<?xml version="1.0" encoding="utf-8"?>
<!-- Fáze 73: žádná záloha do cloudu ani přenos na nový telefon – token zařízení platí jen pro tento telefon,
     data závodu se po spárování stáhnou znovu. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
