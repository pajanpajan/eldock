<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fáze 73: tmavé téma jako web a aplikace pro Windows (žádné bílé probliknutí při startu) -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/eldock_yellow</item>
        <item name="colorPrimaryDark">@color/eldock_background</item>
        <item name="colorAccent">@color/eldock_yellow</item>
        <item name="android:windowBackground">@color/eldock_background</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/eldock_background</item>
    </style>

    <!-- Úvodní obrazovka (Android 12+ SplashScreen): ikona Eldock na tmavém pozadí -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/eldock_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@color/eldock_background</item>
    </style>
</resources>
